# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# electron-builder packaged installers (apps/desktop/release)
release/

# Test / coverage
coverage/
.vitest/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
id_rsa*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
