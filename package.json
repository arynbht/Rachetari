{
  "name": "rivetari",
  "version": "0.0.0",
  "private": true,
  "description": "An auditor and scaffolder for GitHub repositories: controls-as-data, headless engine, PR-based fixes.",
  "license": "MIT",
  "author": "Aryan Bhatia",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint .",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "tsc --build && vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
